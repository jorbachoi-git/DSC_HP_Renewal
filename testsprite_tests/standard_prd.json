{
  "meta": {
    "project": "Dongseo Chemical Website",
    "date": "2026-01-29",
    "prepared_by": "Software Development Manager"
  },
  "product_overview": "Dongseo Chemical Website is a comprehensive platform offering public product information, material safety data sheets (MSDS), and customer inquiry management with secure admin dashboard functionalities.",
  "core_goals": [
    "Provide a user-friendly website for product browsing and inquiry submission.",
    "Implement a secure and functional admin dashboard for managing inquiries and MSDS posts.",
    "Ensure multilingual support and responsive design across devices.",
    "Maintain robust backend API with data validation, security, and error handling.",
    "Enable easy management and moderation of customer inquiries and MSDS content."
  ],
  "key_features": [
    "Public-facing homepage with interactive product galleries, customer inquiry submission, and MSDS browsing.",
    "Multi-language support and responsive UI including mobile navigation and modal popups.",
    "Inquiry system allowing public submission, masking of names, detail view with password protection, and admin replies.",
    "Admin dashboard authentication with JWT tokens, managing inquiries (answer, delete), and MSDS posts (create, edit, delete).",
    "RESTful backend APIs built with Node.js and Netlify Functions including login, inquiry submission, inquiry listing, MSDS management, and admin replies.",
    "Security features including password hashing (bcrypt), JWT authentication, and input sanitization for XSS prevention.",
    "Detailed UI features like hero carousel, Kakao maps integration, and gallery effects for enhanced user experience."
  ],
  "user_flow_summary": [
    "Users visit the homepage, navigate various sections smoothly, and browse product information and galleries.",
    "Users submit inquiries through a form that validates required fields and sends data to backend.",
    "Public inquiries are listed with masked names; users can expand inquiries, enter passwords to view details and admin replies.",
    "Administrators log in using password to receive JWT and access the admin dashboard.",
    "In admin dashboard, admins manage inquiries by answering or deleting them and manage MSDS posts by creating, updating, or deleting content.",
    "APIs validate user input, authenticate admin requests, hash passwords, and handle errors consistently."
  ],
  "validation_criteria": [
    "Frontend UI elements render correctly and interact as expected (responsive design, modals, navigation, language toggle).",
    "API endpoints respond with proper HTTP codes and data formats for success and failure cases.",
    "Password security ensured via bcrypt hashing and JWT token-based authorization.",
    "Data stored in PostgreSQL reliably, with sanitized inputs preventing XSS vulnerabilities.",
    "Admin operations require valid JWT tokens; unauthorized access returns 401 errors.",
    "Inquiry listing and details display proper masking and password verification results.",
    "MSDS posts display, search, pagination, and detail view functionalities operate correctly.",
    "Error handling returns consistent messages and HTTP status codes across frontend and backend.",
    "Sensitive data like passwords or password hashes are never exposed in API responses.",
    "Environment variables securely manage all sensitive configuration values."
  ],
  "code_summary": {
    "tech_stack": [
      "Node.js",
      "JavaScript",
      "Netlify Functions",
      "PostgreSQL (Neon)",
      "jsonwebtoken",
      "bcryptjs"
    ],
    "features": [
      {
        "name": "POST /login",
        "description": "Authenticates an admin user based on a password and returns a JWT.",
        "files": [
          "netlify/functions/login.js"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "Admin Login API",
            "version": "1.0.0"
          },
          "paths": {
            "/.netlify/functions/login": {
              "post": {
                "summary": "Admin login",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "password": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "password"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Successful login, returns JWT",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "token": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "401": {
                    "description": "Invalid credentials"
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "POST /submit-inquiry",
        "description": "Submits a new customer inquiry and stores it in the database.",
        "files": [
          "netlify/functions/submit-inquiry.js"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "Submit Inquiry API",
            "version": "1.0.0"
          },
          "paths": {
            "/.netlify/functions/submit-inquiry": {
              "post": {
                "summary": "Submit a new inquiry",
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "company": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string",
                            "format": "email"
                          },
                          "phone": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "is_public": {
                            "type": "boolean"
                          },
                          "password": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "email",
                          "message",
                          "password"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Inquiry submitted successfully"
                  },
                  "400": {
                    "description": "Missing required fields"
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "GET /get-public-list",
        "description": "Retrieves public inquiries. Can fetch all inquiries if called with admin rights.",
        "files": [
          "netlify/functions/get-public-list.js"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "Get Inquiries API",
            "version": "1.0.0"
          },
          "paths": {
            "/.netlify/functions/get-public-list": {
              "get": {
                "summary": "Get list of inquiries",
                "parameters": [
                  {
                    "name": "getAll",
                    "in": "query",
                    "schema": {
                      "type": "boolean"
                    }
                  }
                ],
                "security": [
                  {
                    "BearerAuth": []
                  }
                ],
                "responses": {
                  "200": {
                    "description": "A list of inquiries"
                  },
                  "401": {
                    "description": "Unauthorized (required for getAll=true)"
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "POST /admin-reply",
        "description": "Allows an admin to post or update a reply to an inquiry.",
        "files": [
          "netlify/functions/admin-reply.js"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "Admin Reply API",
            "version": "1.0.0"
          },
          "paths": {
            "/.netlify/functions/admin-reply": {
              "post": {
                "summary": "Submit an admin reply",
                "security": [
                  {
                    "BearerAuth": []
                  }
                ],
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "inquiryId": {
                            "type": "integer"
                          },
                          "reply": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "inquiryId",
                          "reply"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Reply posted successfully"
                  },
                  "401": {
                    "description": "Unauthorized"
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "POST /create-msds-post",
        "description": "Allows an admin to create a new MSDS post.",
        "files": [
          "netlify/functions/create-msds-post.js"
        ],
        "api_doc": {
          "openapi": "3.0.0",
          "info": {
            "title": "Create MSDS Post API",
            "version": "1.0.0"
          },
          "paths": {
            "/.netlify/functions/create-msds-post": {
              "post": {
                "summary": "Create an MSDS post",
                "security": [
                  {
                    "BearerAuth": []
                  }
                ],
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "content": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "title",
                          "content"
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Post created successfully"
                  },
                  "401": {
                    "description": "Unauthorized"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
