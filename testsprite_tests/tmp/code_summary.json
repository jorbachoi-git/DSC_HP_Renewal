
{
  "tech_stack": [
    "Node.js",
    "JavaScript",
    "Netlify Functions",
    "PostgreSQL (Neon)",
    "jsonwebtoken",
    "bcryptjs"
  ],
  "features": [
    {
      "name": "POST /login",
      "description": "Authenticates an admin user based on a password and returns a JWT.",
      "files": ["netlify/functions/login.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {"title": "Admin Login API", "version": "1.0.0"},
        "paths": {
          "/.netlify/functions/login": {
            "post": {
              "summary": "Admin login",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {"password": {"type": "string"}},
                      "required": ["password"]
                    }
                  }
                }
              },
              "responses": {
                "200": {"description": "Successful login, returns JWT", "content": {"application/json": {"schema": {"type": "object", "properties": {"token": {"type": "string"}}}}}},
                "401": {"description": "Invalid credentials"}
              }
            }
          }
        }
      }
    },
    {
      "name": "POST /submit-inquiry",
      "description": "Submits a new customer inquiry and stores it in the database.",
      "files": ["netlify/functions/submit-inquiry.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {"title": "Submit Inquiry API", "version": "1.0.0"},
        "paths": {
          "/.netlify/functions/submit-inquiry": {
            "post": {
              "summary": "Submit a new inquiry",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "company": {"type": "string"},
                        "email": {"type": "string", "format": "email"},
                        "phone": {"type": "string"},
                        "message": {"type": "string"},
                        "is_public": {"type": "boolean"},
                        "password": {"type": "string"}
                      },
                      "required": ["name", "email", "message", "password"]
                    }
                  }
                }
              },
              "responses": {
                "200": {"description": "Inquiry submitted successfully"},
                "400": {"description": "Missing required fields"}
              }
            }
          }
        }
      }
    },
    {
      "name": "GET /get-public-list",
      "description": "Retrieves public inquiries. Can fetch all inquiries if called with admin rights.",
      "files": ["netlify/functions/get-public-list.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {"title": "Get Inquiries API", "version": "1.0.0"},
        "paths": {
          "/.netlify/functions/get-public-list": {
            "get": {
              "summary": "Get list of inquiries",
              "parameters": [
                {"name": "getAll", "in": "query", "schema": {"type": "boolean"}}
              ],
              "security": [{"BearerAuth": []}],
              "responses": {
                "200": {"description": "A list of inquiries"},
                "401": {"description": "Unauthorized (required for getAll=true)"}
              }
            }
          }
        }
      }
    },
    {
      "name": "POST /admin-reply",
      "description": "Allows an admin to post or update a reply to an inquiry.",
      "files": ["netlify/functions/admin-reply.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {"title": "Admin Reply API", "version": "1.0.0"},
        "paths": {
          "/.netlify/functions/admin-reply": {
            "post": {
              "summary": "Submit an admin reply",
              "security": [{"BearerAuth": []}],
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "inquiryId": {"type": "integer"},
                        "reply": {"type": "string"}
                      },
                      "required": ["inquiryId", "reply"]
                    }
                  }
                }
              },
              "responses": {
                "200": {"description": "Reply posted successfully"},
                "401": {"description": "Unauthorized"}
              }
            }
          }
        }
      }
    },
    {
      "name": "POST /create-msds-post",
      "description": "Allows an admin to create a new MSDS post.",
      "files": ["netlify/functions/create-msds-post.js"],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {"title": "Create MSDS Post API", "version": "1.0.0"},
        "paths": {
          "/.netlify/functions/create-msds-post": {
            "post": {
              "summary": "Create an MSDS post",
              "security": [{"BearerAuth": []}],
              "requestBody": {
                "content": {"application/json": {"schema": {"type": "object", "properties": {"title": {"type": "string"}, "content": {"type": "string"}},"required": ["title", "content"]}}}
              },
              "responses": {
                "200": {"description": "Post created successfully"},
                "401": {"description": "Unauthorized"}
              }
            }
          }
        }
      }
    }
  ]
}
